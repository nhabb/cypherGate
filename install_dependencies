#!/bin/bash
# ============================================================
# AWID3 Defense System - Dependency Installer (ONLY)
# Installs required packages, tools, and Python libraries
# Does NOT copy or move any files
# ============================================================

set -e  # Stop on error

echo "============================================================"
echo "   AWID3 Defense System - Dependency Installer"
echo "   (Installs only - no file copying)"
echo "============================================================"
echo ""

# ============================================================
# 1. Update System Packages
# ============================================================
echo "[1/4] Updating system packages..."
sudo apt update -qq
sudo apt upgrade -y -qq
echo "✅ System updated"
echo ""

# ============================================================
# 2. Install System Tools
# ============================================================
echo "[2/4] Installing system tools..."
sudo apt install -y -qq \
    tcpdump \
    aircrack-ng \
    tmux \
    htop \
    iptables \
    net-tools \
    wireless-tools \
    usbutils \
    pciutils \
    python3 \
    python3-pip \
    python3-venv
echo "✅ System tools installed"
echo ""

# ============================================================
# 3. Create Virtual Environment (if not exists)
# ============================================================
echo "[3/4] Setting up Python virtual environment..."

if [ -d "venv" ]; then
    echo "   Virtual environment already exists. Skipping creation."
else
    python3 -m venv venv
    echo "   Virtual environment created."
fi

# Activate and upgrade pip
source venv/bin/activate
pip install --upgrade pip -q
echo "✅ Virtual environment ready"
echo ""

# ============================================================
# 4. Install Python Libraries
# ============================================================
echo "[4/4] Installing Python libraries (this may take a few minutes)..."

# Core ML libraries
pip install -q numpy pandas scikit-learn
echo "   ✓ numpy, pandas, scikit-learn"

# Gradient boosting frameworks
pip install -q lightgbm xgboost
echo "   ✓ lightgbm, xgboost"

# Utilities
pip install -q joblib pyyaml tqdm psutil
echo "   ✓ joblib, pyyaml, tqdm, psutil"

# Network capture and analysis
pip install -q scapy
echo "   ✓ scapy"

# Parquet support
pip install -q pyarrow
echo "   ✓ pyarrow"

# Optional (for potential future features)
pip install -q matplotlib seaborn
echo "   ✓ matplotlib, seaborn"

echo ""
echo "✅ All Python libraries installed"
echo ""

# ============================================================
# 5. Verify Installation
# ============================================================
echo "[5/5] Verifying installation..."

# Test imports
python -c "
import sys
import numpy
import pandas
import sklearn
import lightgbm
import xgboost
import joblib
import yaml
import tqdm
import scapy
import pyarrow
print('✅ All Python imports successful')
" 2>/dev/null || {
    echo "❌ Some imports failed. Check errors above."
    exit 1
}

# Check system tools
for tool in tcpdump airmon-ng tmux; do
    if command -v $tool &> /dev/null; then
        echo "✅ $tool found"
    else
        echo "⚠️ $tool not found (may affect functionality)"
    fi
done

echo ""
echo "✅ Verification complete"
echo ""

# ============================================================
# 6. Summary
# ============================================================
echo "============================================================"
echo "   INSTALLATION COMPLETE!"
echo "============================================================"
echo ""
echo "To activate the virtual environment:"
echo "  source venv/bin/activate"
echo ""
echo "To run the orchestrator (after activating venv):"
echo "  python CYPHERGATE.py"
echo ""
echo "To run live detection manually:"
echo "  sudo venv/bin/python scripts/CYPHERGATE__LIVE_DETECTOR.py --live --interface wlan1mon"
echo ""
echo "To run guardian in another terminal:"
echo "  sudo venv/bin/python scripts/guardian.py"
echo ""
echo "To analyze a saved file:"
echo "  venv/bin/python scripts/CYPHERGATE__LIVE_DETECTOR.py --file /path/to/attack.parquet"
echo ""
echo "============================================================"